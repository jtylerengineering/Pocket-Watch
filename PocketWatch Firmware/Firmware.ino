void onRot() {
    if(digitalRead(rotA) == digitalRead(rotB)){
        enCount--;
    }
    else{
        enCount++;
    }
}

class MyServerCallbacks : public BLEServerCallbacks {

    void onConnect(BLEServer *pWatchServer) {
        Serial.println("Device Conected! :D");
    }

    void onDisconnect(BLEServer *pWatchServer){
        Serial.println("Device Disconnected");
        BLEDevice::startAdvertising();
    }
};


void 

void setup(){
    pinMode(rotA, INPUT_PULLUP);
    pinMode(rotB, INPUT_PULLUP);
    pinMode(en_SW, INPUT_PULLUP);
    pinMode(BL, OUTPUT);

    //encoder initialization
    attachInterrupt(digitalPinToInterrupt(rotA), onRot, CHANGE);
    
    //display initialization
    tft.init(240, 240);
    tft.fillScreen(BLACK);
    tft.setTextSize(4);
    tft.setTextColor(Yellow);
    tft.setCursor(int16_t x67, int16_t y126);

    //BLE -- will be implimented with some serious testing during week 9
    Serial.begin(9600);
    Serial.println("ESP32 BLE server initializing...")
    BLEDevice::init(DEVICE_NAME);
    BLEServer *pWatchServer = BLEDevice::createServer();
    pWatchServer->setCallbacks(new MyServerCallbacks());
    BLEDevice::startAdvertising();

    hourFormat12();

}

